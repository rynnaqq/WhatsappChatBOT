# Run npm run setup to create .env with a random SESSION_SECRET.
# Local defaults; Pterodactyl's exported SERVER_PORT overrides PORT automatically.
# On Pterodactyl, HOST defaults to 0.0.0.0 unless explicitly exported in Startup.
PORT=3000
HOST=127.0.0.1
DASHBOARD_PASSWORD=
SESSION_SECRET=
LOG_LEVEL=info
STORAGE_DIR=./storage
# Enable ONLY behind a trusted reverse proxy that sanitizes forwarded headers.
TRUST_PROXY=false
SESSION_TTL_HOURS=12
# Optional limits
MAX_TOKENS_CEILING=32768
